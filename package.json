{
  "name": "dsh-yukimi-theme",
  "version": "1.2.0",
  "description": "佐城雪美主题：深蓝配色、卡面背景、桌面宠物纸片小人、Mobamas 轮播、签名铭牌。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "desktop",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:preview": "node scripts/preview-desktop.mjs",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop:sync": "node scripts/sync-desktop.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlyceStocking/dsh-yukimi-theme.git"
  },
  "homepage": "https://github.com/AlyceStocking/dsh-yukimi-theme#readme",
  "bugs": {
    "url": "https://github.com/AlyceStocking/dsh-yukimi-theme/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-yukimi-theme"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
